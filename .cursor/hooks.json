{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/guard-write.py",
        "matcher": "Write|Edit|Replace|Delete|Notebook",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard-shell.py",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
