# ASD-GenDecoder 环境变量模板
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，严禁提交。
#   cp .env.example .env

# ============ 必填 ============

# MiniMax M3 API 密钥。获取方式见 docs/env-setup.md 第三步。
# 在 https://platform.minimax.io/ 控制台 > API Keys > Create new key 生成，形如 sk-cp-...
MINIMAX_API_KEY=sk-cp-替换为你的真实密钥

# HPO-MCP-Server 编译产物的绝对路径。
# 后端以 `node <此路径>` 启动 stdio 子进程调用 search_hpo_terms。
# 每台机器路径不同，必须按实际情况修改。编译方式见 docs/env-setup.md 阶段二。
HPO_MCP_SERVER_PATH=/Users/joywu/Desktop/hackathon-genetic-counseling-agent/HPO-MCP-Server/build/index.js

# ============ 可选（留空则使用代码内默认值）============

# MiniMax 接口地址与模型名
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ChromaDB 本地持久化目录，由 rag_builder.py 生成
CHROMA_DB_PATH=./chroma_db

# 向量化模型。知识库为中文，必须使用中文/多语言模型；
# 灌库与检索两端必须一致，改动后需重新运行 rag_builder.py。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Streamlit 前端访问后端的地址
BACKEND_URL=http://127.0.0.1:8000
