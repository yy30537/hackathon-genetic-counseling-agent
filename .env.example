# ASD-GenDecoder 环境变量模板
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，严禁提交。
#   cp .env.example .env
#
# 使用独立 git worktree 时，每个 worktree 都需要自己的 .env；该文件不会从主工作区自动继承。
# 后端 worktree 必须能访问稳定的 ChromaDB 与 HPO-MCP-Server，建议填写它们在主工作区中的绝对路径。
# 前端 worktree 主要使用 BACKEND_URL，但仍可复制同一份模板。

# ============ 必填 ============

# MiniMax M3 API 密钥。获取方式见 docs/env-setup.md 第三步。
# 在 https://platform.minimax.io/ 控制台 > API Keys > Create new key 生成，形如 sk-cp-...
MINIMAX_API_KEY=

# HPO-MCP-Server 编译产物的绝对路径。
# 后端以 `node <此路径>` 启动 stdio 子进程调用 search_hpo_terms。
# 每台机器路径不同，必须填写绝对路径。编译方式见 docs/env-setup.md 阶段二。
# worktree 示例：/ABSOLUTE/PATH/TO/hackathon-genetic-counseling-agent/HPO-MCP-Server/build/index.js
HPO_MCP_SERVER_PATH=/ABSOLUTE/PATH/TO/HPO-MCP-Server/build/index.js

# ============ 可选（留空则使用代码内默认值）============

# MiniMax 接口地址与模型名
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# ChromaDB 本地持久化目录，由 scripts/rag_builder.py 生成。
# 双 worktree 并行时建议后端指向已验证 collection 的绝对路径；后端运行期间禁止重新灌库。
# 示例：/ABSOLUTE/PATH/TO/hackathon-genetic-counseling-agent/chroma_db
CHROMA_DB_PATH=/ABSOLUTE/PATH/TO/chroma_db

# 向量化模型。知识库为中文，必须使用中文/多语言模型；
# 灌库与检索两端必须一致（两端都从根目录 config.py 读取），改动后需重新运行 scripts/rag_builder.py。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Streamlit 前端访问后端的地址。后端使用默认 8000 端口时无需修改。
BACKEND_URL=http://127.0.0.1:8000
